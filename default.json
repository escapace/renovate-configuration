{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "automergeType": "pr",
  "constraintsFiltering": "strict",
  "dependencyDashboard": true,
  "dependencyDashboardAutoclose": true,
  "dependencyDashboardFooter": "",
  "dependencyDashboardHeader": "",
  "dependencyDashboardLabels": [],
  "enabledManagers": ["npm"],
  "extends": ["config:recommended", "schedule:weekly", "workarounds:typesNodeVersioning"],
  "internalChecksFilter": "strict",
  "labels": [],
  "lockFileMaintenance": { "enabled": true },
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "rangeStrategy": "pin",
      "semanticCommitScope": "deps",
      "semanticCommitType": "chore"
    },
    {
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "bump",
      "semanticCommitScope": "deps",
      "semanticCommitType": "chore"
    },
    {
      "matchDepTypes": ["peerDependencies"],
      "matchUpdateTypes": ["major"],
      "semanticCommitType": "feat"
    },
    {
      "matchDepTypes": ["dependencies"],
      "rangeStrategy": "bump",
      "semanticCommitScope": "deps",
      "semanticCommitType": "fix"
    },
    {
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "automerge": true,
      "groupName": "escapace",
      "groupSlug": "escapace",
      "matchPackageNames": [
        "prettier-config-escapace",
        "@escapace/*",
        "esroll",
        "eslint-config-escapace",
        "coastal",
        "fastify-fetch",
        "@pangram/*",
        "@pointe/*",
        "caslon",
        "@caslon/*",
        "cepheus",
        "seedpods",
        "pointe",
        "@cepheus/*",
        "cassiopeia",
        "snaproll",
        "@cassiopeia/*"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": null,
      "schedule": ["at any time"]
    },
    {
      "automerge": true,
      "matchUpdateTypes": ["lockFileMaintenance"],
      "semanticCommitScope": "deps",
      "semanticCommitType": "chore"
    },
    {
      "automerge": true,
      "groupName": "node",
      "groupSlug": "node",
      "matchDepTypes": ["devDependencies", "engines"],
      "matchPackageNames": ["@types/node", "node"],
      "schedule": ["at any time"]
    },
    {
      "automerge": true,
      "groupName": "typescript",
      "groupSlug": "typescript",
      "matchDepTypes": ["devDependencies", "peerDependencies"],
      "matchPackageNames": ["typescript"],
      "schedule": ["at any time"]
    },
    { "allowedVersions": "<10", "matchPackageNames": ["eslint"] },
    {
      "allowedVersions": "<6",
      "matchDepTypes": ["devDependencies", "peerDependencies"],
      "matchPackageNames": ["typescript"]
    },
    {
      "allowedVersions": "<25",
      "matchDepTypes": ["devDependencies", "engines"],
      "matchPackageNames": ["@types/node", "node"]
    },
    {
      "enabled": false,
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["minor", "patch"]
    }
  ],
  "platformAutomerge": true,
  "platformCommit": "enabled",
  "postUpdateOptions": ["pnpmDedupe"],
  "prConcurrentLimit": 10,
  "prCreation": "immediate",
  "prFooter": "",
  "prHeader": "",
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "semanticCommits": "enabled",
  "updateNotScheduled": true,
  "vulnerabilityAlerts": {
    "assignees": ["yyxi"],
    "automerge": true,
    "dependencyDashboardApproval": false,
    "enabled": true,
    "minimumReleaseAge": null,
    "prCreation": "immediate",
    "rangeStrategy": "update-lockfile",
    "schedule": ["at any time"],
    "vulnerabilityFixStrategy": "lowest"
  }
}
